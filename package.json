{
  "name": "moscheen-sh",
  "version": "1.0.0",
  "private": true,
  "description": "Website der Moscheen der Ahmadiyya Muslim Jamaat in Schleswig-Holstein (Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "db:seed:generate": "node scripts/generate-seed-sql.mjs",
    "db:migrate:local": "wrangler d1 migrations apply moscheen-sh-db --local",
    "db:seed:local": "wrangler d1 execute moscheen-sh-db --local --file=db/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply moscheen-sh-db --remote",
    "db:seed:remote": "wrangler d1 execute moscheen-sh-db --remote --file=db/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
